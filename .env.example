# Copy this file to .env and fill in the values. Never commit .env.

# --- Used by the website (safe to be public; bundled into the browser code) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Used only by local data tools (NEVER put these in a VITE_ variable) ---
SUPABASE_URL=
SUPABASE_SECRET_KEY=
