# Copy this file to .env and fill in the values. Never commit .env.

# --- Used by the website (safe to be public; bundled into the browser code) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Used only by local data tools (NEVER put these in a VITE_ variable) ---
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Used by the AWS deploy to manage DNS for scheduler.hamapps.dev (secret: never commit) ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_DEFAULT_ACCOUNT_ID=

# --- Used by the /api/auth sign-in server (secret: never commit) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
AUTH_COOKIE_SECRET=
